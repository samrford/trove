# Backend environment variables (reference). Local dev values live in the
# Tiltfile, which auto-loads `backend/.env` when present.
# Drop real secrets into a gitignored `backend/.env`.

DATABASE_URL=postgres://trove:password@localhost:5434/trove?sslmode=disable
SUPABASE_URL=https://your-project-ref.supabase.co
PORT=8082

# Object storage - Leave STORAGE_ENDPOINT
# unset to disable the attachments feature entirely.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=trove
STORAGE_REGION=us-east-1
# MinIO needs path-style URLs; Tigris is happy either way. Set to "false"
# only if your provider rejects path-style.
STORAGE_USE_PATH_STYLE=true

# Google Photos picker — optional. Leave any of these blank to keep
# the feature disabled (frontend hides the button automatically).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# 32-byte random hex string.
GOOGLE_TOKEN_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:5173
